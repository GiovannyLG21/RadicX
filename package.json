{
  "name": "expressjs-server",
  "version": "1.0.0",
  "description": "API in ExpressJS",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:workers": "node dist/Bot/config/workers.js",
    "test": "cross-env NODE_ENV=test jest",
    "seed": "npx prisma db seed",
    "workers": "npx nodemon --exec tsx -r tsconfig-paths/register src/Bot/config/workers.ts"
  },
